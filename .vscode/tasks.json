{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ensure-deps",
            "type": "shell",
            "command": "make _ensure-deps",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "docker:infra:up",
            "type": "shell",
            "command": "make infra",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "docker:infra:down",
            "type": "shell",
            "command": "make infra-down",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
