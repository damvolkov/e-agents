{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "dev console",
            "type": "debugpy",
            "request": "launch",
            "module": "e_agents.cli.main",
            "args": ["console", "--session", "web"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "dev server",
            "type": "debugpy",
            "request": "launch",
            "module": "e_agents.cli.main",
            "args": ["run", "--session", "web"],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
